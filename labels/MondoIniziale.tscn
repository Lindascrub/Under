[sub_resource type="GDScript" id="GDScript_x4bn3"]
script/source = "extends Node2D

@onready var porta_ascensore = get_node_or_null(\"MuriAscensore3\")

func _ready() -> void:
	print(\"L'ascensore aziendale sta scendendo... Puoi muoverti nella cabina.\")
	
	# Aspettiamo i 5 secondi di viaggio
	await get_tree().create_timer(5.0).timeout
	
	print(\"Le porte si aprono. Puoi uscire!\")
	if porta_ascensore:
		porta_ascensore.queue_free() 
	else:
		print(\"NOTA: MuriAscensore3 non trovato o già rimosso.\")

# QUESTO È IL SEGNALE GIUSTO COLLEGATO ORA!
func _on_uscita_ascensore_body_entered(body: Node2D) -> void:
	print(\"Il sensore ha sentito qualcosa: \", body.name)
	
	# Controlliamo se è un CharacterBody2D (il tuo giocatore)
	if body is CharacterBody2D:
		print(\"Giocatore confermato! Tento il cambio scena verso il corridoio...\")
		
		# Controlliamo entrambi i percorsi possibili per non rischiare!
		if ResourceLoader.exists(\"res://corridoio.tscn\"):
			get_tree().change_scene_to_file(\"res://corridoio.tscn\")
		elif ResourceLoader.exists(\"res://labels/corridoio.tscn\"):
			get_tree().change_scene_to_file(\"res://labels/corridoio.tscn\")
		else:
			print(\"ERRORE: Il file corridoio.tscn non esiste in nessuna delle due cartelle!\")
"

