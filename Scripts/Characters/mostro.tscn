[sub_resource type="GDScript" id="GDScript_5t6n7"]
script/source = "extends Area2D

signal combattimento_iniziato

func _ready():
	# Quando il player tocca il mostro
	body_entered.connect(_on_body_entered)

func _on_body_entered(body):
	if body.name == \"Player\":
		combattimento_iniziato.emit()
		queue_free() # Il mostro scompare (poi lo gestiremo meglio)
"

