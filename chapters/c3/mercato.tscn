look = "left"
lines = PackedStringArray("Ho comprato tre cose che non mi servono. Ma erano al 50%!", "Lo scontrino è più lungo di me. Lo tengo come ricordo.", "Il carrello cigola. Lo prendo come un complimento.")

[node name="Cliente1" type="StaticBody2D" parent="Mondo" unique_id=232408115]
position = Vector2(200, 94)
script = ExtResource("37_6ra1p")
sheet = "char_16"
route = PackedVector2Array(200, 94, 296, 94, 264, 94)
lines = PackedStringArray("Mi scusi, sa dov\'è il reparto Felicità? Sulla mappa c\'è, ma è in esaurimento.", "Il latte costa quanto un\'ora di cassa. Lo guardo e basta. Guardare è ancora gratis. Credo.")

