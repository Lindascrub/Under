[node name="GuardaSchedari" type="Node2D" parent="Mondo" unique_id=1676433677]
position = Vector2(248, 136)
script = ExtResource("6_qwkmx")
lines = PackedStringArray("* Schedari dell\'archivio, pieni fino a scoppiare. Ogni cassetto ha un\'etichetta: \"1984\", \"1985\", \"1986\"...", "* Il cassetto \"OGGI\" è chiuso a chiave.")
lines_after = PackedStringArray("* Apri un cassetto. Cartelline, cartelline, cartelline. Tutte vuote. Qualcuna ha dentro un foglio bianco, perché sembri piena.")
after_flag = "c2_rivelazione"

