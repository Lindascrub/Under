script = ExtResource("6_qwkmx")
lines = PackedStringArray("* Uno schedario ha un post-it: \"NON APRIRE. ARCHIVIO DELL\'ARCHIVIO\".")
lines_after = PackedStringArray("* L\'archivio dell\'archivio. Dentro c\'è un elenco di cassetti vuoti. È l\'unica cosa vera, qui dentro.")
