[node name="GuardaSorridi" type="Node2D" parent="Mondo" unique_id=1157241517]
position = Vector2(56, 56)
script = ExtResource("6_qwkmx")
lines = PackedStringArray("* Un poster con una faccina gialla: \"SORRIDI! È GRATIS\".", "* Sotto, in piccolo: \"Il sorriso è parte integrante della mansione (art. 4 del contratto)\".")
lines_after = PackedStringArray("* \"SORRIDI! È GRATIS\". Adesso che la musica si è fermata una volta, la faccina sembra un ordine.")
after_flag = "c2_rivelazione"

[node name="GuardaModulo" type="Node2D" parent="Mondo" unique_id=8272890]
position = Vector2(120, 56)
script = ExtResource("6_qwkmx")
lines = PackedStringArray("* \"UN MODULO AL GIORNO TOGLIE IL PENSIERO\".", "* Qualcuno ha cancellato \"il pensiero\" e scritto sopra a penna: \"la giornata\". Poi qualcun altro ha cancellato anche quello.")
lines_after = PackedStringArray("* \"UN MODULO AL GIORNO TOGLIE IL PENSIERO\". Ora sai dove vanno, i moduli. Il pensiero, invece, resta.")
after_flag = "c2_rivelazione"

[node name="GuardaAttesa" type="Node2D" parent="Mondo" unique_id=1152324399]
position = Vector2(248, 56)
script = ExtResource("6_qwkmx")
lines = PackedStringArray("* \"RESTI IN LINEA!\". Il cartello è appeso proprio sopra l\'altoparlante della musichetta.", "* La musichetta è sempre la stessa. Dura quarantadue secondi. L\'hai già contata tre volte.")
lines_after = PackedStringArray("* \"RESTI IN LINEA!\". La musichetta è ripartita, più lenta. Come una giostra che nessuno ha il coraggio di spegnere.")
after_flag = "c2_rivelazione"

