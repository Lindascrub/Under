[node name="GuardaRegaloBlu" type="Node2D" parent="Mondo" unique_id=1425556698]
position = Vector2(152, 184)
script = ExtResource("6_kwl31")
lines = PackedStringArray("* Un regalo blu, con il tuo nome scritto a mano sul biglietto. Come facevano a saperlo?", "* Dentro c\'è un modulo: \"Dichiarazione di disponibilità al lavoro straordinario\". Già firmato. Con la tua firma.")
lines_after = PackedStringArray("* Il regalo blu, spento, sembra solo una scatola. Il modulo dentro è ancora firmato.")
