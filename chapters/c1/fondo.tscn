position = Vector2(56, 56)
script = ExtResource("7_i6r6f")
lines = PackedStringArray("* Un palloncino blu. Lo tocchi: è tiepido. Come se qualcuno ci avesse soffiato dentro poco fa.", "* Su un\'etichetta: \"Gonfiato al piano terra. Non riutilizzabile\".")
