position = Vector2(264, 56)
script = ExtResource("6_kwl31")
lines = PackedStringArray("* Un palloncino verde. Dentro c\'è un bigliettino: \"Hai vinto un turno extra!\".", "* Sul retro, in piccolo: \"Il premio non è convertibile in tempo libero\".")
lines_after = PackedStringArray("* Il palloncino verde è per terra. Il bigliettino è rimasto dentro, ma ormai non lo legge nessuno.")
