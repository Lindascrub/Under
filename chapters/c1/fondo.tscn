[node name="GuardaRegaloRosso" type="Node2D" parent="Mondo" unique_id=249821546]
position = Vector2(216, 168)
script = ExtResource("4_n0ai6")
lines = PackedStringArray("* Un regalo impacchettato benissimo. Lo scuoti: è vuoto.", "* Sul biglietto: \"Il regalo sei tu. Con affetto, l\'Ufficio Risorse Umane\".")
lines_after = PackedStringArray("* Il regalo rosso è grigio. Il fiocco si è sciolto da solo. Dentro, sempre niente.")
