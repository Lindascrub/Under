position = Vector2(152, 56)
script = ExtResource("7_i6r6f")
lines = PackedStringArray("* Un palloncino rosso a forma di cuore. Sopra: \"LA CHEAP TI VUOLE BENE\".", "* Il filo è legato a un peso di piombo. Così non vola via. Come te.")
