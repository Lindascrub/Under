script = ExtResource("6_kwl31")
lines = PackedStringArray("* Un palloncino giallo. Ci hanno stampato sopra: \"BENVENUTO AL FONDO!\".", "* Non c\'è scritto il nome di nessuno. Va bene per tutti quelli che arrivano.")
lines_after = PackedStringArray("* Il palloncino giallo è afflosciato. La scritta adesso dice \"BENVE...\". Il resto è una piega.")
after_flag = "c1_rivelazione"

